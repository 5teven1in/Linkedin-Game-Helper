{
    "manifest_version": 3,
    "version": "0.6.0",
    "name": "LGH",
    "description": "Linkedin Game Helper",
    "content_scripts": [
        {
            "all_frames": false,
            "matches": [
                "https://www.linkedin.com/game",
                "https://www.linkedin.com/game/*",
                "https://www.linkedin.com/games",
                "https://www.linkedin.com/games/*"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "js": [
                "queue.js",
                "gameHelper.js",
                "gameRunner.js"
            ]
        }
    ]
}
